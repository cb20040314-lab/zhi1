# Python bytecode
__pycache__/
*.py[cod]

# Local SQLite runtime data (including WAL auxiliary files)
app/data/*.db
app/data/*.db-shm
app/data/*.db-wal

# Local environment and editor settings
.venv/
venv/
.env
.vscode/

# Test artifacts
scripts/smoke_out.txt

# HTML self-check screenshots (regenerated by shot.py)
app/static/_shots/

# Real TTS outputs (regenerated on each run)
app/static/audio/turn_*.mp3
